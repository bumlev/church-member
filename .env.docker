APP_NAME="Church Member API"
APP_ENV=local
APP_KEY=base64:kQ/BsUwvjcv51VZdelPi2hq+wbQDVa1iMjirouOKNu4=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MariaDB container) ──────────────────────────────────────────────
# DB_HOST  = service name from docker-compose.yml  (NOT 127.0.0.1)
# DB_PORT  = internal container port               (NOT 3307 — that is the host port)
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=church_member
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
#MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="bumwejaychris@gmail.com"
MAIL_PASSWORD="ohcq bmhc yqla gekt"
MAIL_FROM_ADDRESS="bumwejaychris@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Swagger ───────────────────────────────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true

VITE_APP_NAME="${APP_NAME}"

# ── Member pictures ───────────────────────────────────────────────────────────
PICTURES_REMOTE_ENABLED=false
# local | remote
PICTURES_SERVE_FROM=local

