{
    "openapi": "3.0.0",
    "info": {
        "title": "Church Member Management API",
        "description": "API documentation for the Church Member Management System. Covers geographic data (provinces, districts, sectors, cellules, villages) and member management.",
        "contact": {
            "name": "Church Member API Support",
            "email": "support@church-member.local"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1"
        }
    ],
    "paths": {
        "/{sector}/cellules": {
            "get": {
                "tags": [
                    "Cellules"
                ],
                "summary": "List cellules by sector",
                "description": "Returns all cellules belonging to the specified sector, ordered alphabetically.",
                "operationId": "2740afc149080eac03b7a4ea652383db",
                "parameters": [
                    {
                        "name": "sector",
                        "in": "path",
                        "description": "The ID of the sector",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A list of cellules for the given sector",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/CelluleResource"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Sector not found"
                    }
                }
            }
        },
        "/{province}/districts": {
            "get": {
                "tags": [
                    "Districts"
                ],
                "summary": "List districts by province",
                "description": "Returns all districts belonging to the specified province, ordered alphabetically.",
                "operationId": "97e7972f1a112879ab19d6f5fd361389",
                "parameters": [
                    {
                        "name": "province",
